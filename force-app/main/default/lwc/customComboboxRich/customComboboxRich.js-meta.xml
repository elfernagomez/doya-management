<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
	<apiVersion>61.0</apiVersion>
	<isExposed>true</isExposed>
	<masterLabel>Custom Combobox Rich</masterLabel>
	<description>A custom combobox component with support for icons, multiple lines, and badges</description>
	<targets>
		<target>lightning__AppPage</target>
		<target>lightning__RecordPage</target>
		<target>lightning__HomePage</target>
		<target>lightningCommunity__Page</target>
	</targets>
	<targetConfigs>
		<targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
			<property name="label" type="String" label="Label" description="The label for the combobox"/>
			<property name="placeholder" type="String" label="Placeholder" default="Select an option" description="Placeholder text"/>
			<property name="variant" type="String" label="Variant" default="standard" description="Label display variant: standard, label-inline, or label-hidden" datasource="standard,label-inline,label-hidden"/>
			<property name="required" type="Boolean" label="Required" default="false" description="Whether the field is required"/>
			<property name="disabled" type="Boolean" label="Disabled" default="false" description="Whether the field is disabled"/>
		</targetConfig>
	</targetConfigs>
</LightningComponentBundle>
