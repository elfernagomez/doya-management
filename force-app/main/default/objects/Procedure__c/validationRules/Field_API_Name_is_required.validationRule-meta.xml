<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Field_API_Name_is_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Details_Type__c , &apos;Field&apos;),
  ISBLANK(Details_Field_API_Name__c)
)</errorConditionFormula>
    <errorDisplayField>Details_Field_API_Name__c</errorDisplayField>
    <errorMessage>A Field  API Name is required if the Details Type is &quot;Field&quot;</errorMessage>
</ValidationRule>
