<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>decision_isDescriptionEmpty</name>
        <label>Is Description Empty?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Description set. No action needed.</defaultConnectorLabel>
        <rules>
            <name>outcome_noDescriptionSetDefaultValueIsNeeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Description</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_setDefaultDescription</targetReference>
            </connector>
            <label>No description set, default value is needed</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formula_defaultDescription</name>
        <dataType>String</dataType>
        <expression>{!$Record.Product2.Name} &amp; &quot; for &quot; &amp; {!$Record.DeliveryGroup__r.Name}</expression>
    </formulas>
    <interviewLabel>Opportunity Product: On Before Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Product: On Before Create</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>update_setDefaultDescription</name>
        <label>Set Default Description</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>formula_defaultDescription</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>decision_isDescriptionEmpty</targetReference>
        </connector>
        <object>OpportunityLineItem</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
