    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_orderAccount</name>
        <label>Get Order Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_defaultPickupCenterAccount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Order__c</elementReference>
            </value>
        </filters>
        <object>Order</object>
        <outputAssignments>
            <assignToReference>var_orderAccountId</assignToReference>
            <field>AccountId</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>get_defaultPickupCenterAccount</name>
        <label>Get Default Pickup Center Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>update_setDefaults</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsInternal__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsHeadquarters__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <outputAssignments>
            <assignToReference>var_pickupCenterId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>update_setDefaults</name>
        <label>Set Defaults</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>DeliveryType__c</field>
            <value>
                <elementReference>formula_deliveryTypeDefault</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeliveryLocationType__c</field>
            <value>
                <elementReference>formula_deliveryLocationTypeDefault</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PickupLocationType__c</field>
            <value>
                <elementReference>formula_pickupLocationTypeDefault</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DeliveryCenter__c</field>
            <value>
                <elementReference>formula_deliveryCenterDefault</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PickupCenter__c</field>
            <value>
                <elementReference>formula_pickupCenterDefault</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <formulas>
        <name>formula_deliveryTypeDefault</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.DeliveryType__c})), "Delivery", TEXT({!$Record.DeliveryType__c}))</expression>
    </formulas>
    <formulas>
        <name>formula_deliveryLocationTypeDefault</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.DeliveryLocationType__c})), "Delivery Center", TEXT({!$Record.DeliveryLocationType__c}))</expression>
    </formulas>
    <formulas>
        <name>formula_pickupLocationTypeDefault</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.PickupLocationType__c})), "Pickup Center", TEXT({!$Record.PickupLocationType__c}))</expression>
    </formulas>
    <formulas>
        <name>formula_deliveryCenterDefault</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.DeliveryCenter__c}), {!var_orderAccountId}, {!$Record.DeliveryCenter__c})</expression>
    </formulas>
    <formulas>
        <name>formula_pickupCenterDefault</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.PickupCenter__c}), {!var_pickupCenterId}, {!$Record.PickupCenter__c})</expression>
    </formulas>
